<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StudentApp.Views.LogViewerPage"
             Title="Журнал подій">

    <Grid RowDefinitions="Auto,Auto,*" Padding="16" RowSpacing="10">

        <!-- Фільтри: рівень, кількість записів N, оновлення -->
        <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="8">
            <Picker Grid.Column="0"
                    Title="Рівень"
                    ItemsSource="{Binding LevelOptions}"
                    SelectedItem="{Binding SelectedLevel, Mode=TwoWay}" />

            <Picker Grid.Column="1"
                    Title="Кількість записів"
                    ItemsSource="{Binding CountOptions}"
                    SelectedItem="{Binding SelectedCount, Mode=TwoWay}" />

            <Button Grid.Column="2"
                    Text="🔄 Оновити"
                    Command="{Binding LoadCommand}" />
        </Grid>

        <VerticalStackLayout Grid.Row="1" Spacing="2">
            <Label Text="{Binding Summary}" FontAttributes="Bold" />
            <Label Text="{Binding LogDirectory, StringFormat='Папка: {0}'}"
                   FontSize="11"
                   TextColor="Gray" />
        </VerticalStackLayout>

        <!-- Список записів -->
        <CollectionView Grid.Row="2" ItemsSource="{Binding Entries}">
            <CollectionView.EmptyView>
                <Label Text="Записів не знайдено"
                       HorizontalOptions="Center"
                       Margin="0,20" />
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="8" Margin="0,3" StrokeThickness="1">
                        <VerticalStackLayout Spacing="3">

                            <HorizontalStackLayout Spacing="8">
                                <!-- Кольорова мітка рівня -->
                                <Border BackgroundColor="{Binding LevelColor}"
                                        Padding="6,1"
                                        StrokeThickness="0">
                                    <Label Text="{Binding Level}"
                                           TextColor="White"
                                           FontAttributes="Bold"
                                           FontSize="12" />
                                </Border>
                                <Label Text="{Binding TimeText}"
                                       FontSize="12"
                                       VerticalOptions="Center" />
                                <Label Text="{Binding ShortSource}"
                                       FontSize="12"
                                       TextColor="Gray"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>

                            <Label Text="{Binding Message}"
                                   LineBreakMode="WordWrap" />

                            <!-- Виняток і стек викликів (якщо є) -->
                            <Label Text="{Binding Exception}"
                                   IsVisible="{Binding HasException}"
                                   FontFamily="Consolas"
                                   FontSize="11"
                                   TextColor="OrangeRed"
                                   MaxLines="6"
                                   LineBreakMode="TailTruncation" />

                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <ActivityIndicator Grid.Row="2"
                           IsRunning="{Binding IsBusy}"
                           IsVisible="{Binding IsBusy}"
                           VerticalOptions="Start" />
    </Grid>

</ContentPage>
