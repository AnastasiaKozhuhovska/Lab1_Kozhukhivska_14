<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StudentApp.Views.StudentDetailPage"
             Title="Редагування студента">

    <VerticalStackLayout Padding="24" Spacing="16">

        <Label Text="Редагування студента"
               FontSize="22"
               FontAttributes="Bold" />

        <Label Text="ПІБ:" />
        <Entry Text="{Binding FullName, Mode=TwoWay}"
               Placeholder="ПІБ студента" />

        <Label Text="Група:" />
        <Entry Text="{Binding Group, Mode=TwoWay}"
               Placeholder="Група" />

        <Label Text="Номер студентського квитка:" />
        <Entry Text="{Binding StudentCardNumber, Mode=TwoWay}"
               Placeholder="Номер студентського квитка" />

        <Label Text="Середній бал:" />
        <Entry Text="{Binding AverageScore, Mode=TwoWay}"
               Keyboard="Numeric" />

        <Button Text="Зберегти"
                Command="{Binding SaveCommand}"
                Margin="0,10,0,0" />

        <Button Text="Назад"
                Command="{Binding GoBackCommand}"
                Margin="0,10,0,0" />

    </VerticalStackLayout>

</ContentPage>
